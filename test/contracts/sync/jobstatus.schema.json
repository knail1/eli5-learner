{
  "$id": "eli5-learner/sync/jobstatus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": { "type": "number", "const": 1 },
    "jobId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "state": { "type": "string", "enum": ["received", "queued", "running", "done", "failed", "rejected", "cancelled"] },
    "stage": { "type": "string", "maxLength": 200, "pattern": "^[^\\r\\n\\u2028\\u2029]*$" },
    "docId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "versionId": { "type": "string", "pattern": "^v-[0-9a-f]{12}$" },
    "skippedSources": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "anchorId": { "type": "string", "pattern": "^(?:q-[0-9a-f]{8}|sec-[a-z][a-z0-9]{1,15}-[0-9a-f]{8})$" },
    "code": { "type": "string", "pattern": "^E_[A-Z][A-Z0-9_]{0,39}$" },
    "reason": { "type": "string", "maxLength": 300, "pattern": "^[^\\r\\n\\u2028\\u2029]*$" }
  },
  "required": ["v", "jobId", "updatedAt", "state"],
  "additionalProperties": false,
  "title": "JobStatus",
  "description": "jobstatus-<jobId>.json (16 §5.3)"
}
