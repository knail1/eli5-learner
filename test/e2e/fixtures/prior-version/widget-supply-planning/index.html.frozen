 Last year" data-value="30" tabindex="0"/><text x="302.06" y="125.67" text-anchor="middle" class="viz-ink viz-value">30</text><rect x="340.87" y="141.42" width="66.12" height="150.58" class="viz-fill-muted" data-label="Wholesale · This year" data-value="28" tabindex="0"/><text x="373.94" y="136.42" text-anchor="middle" class="viz-ink viz-value">28</text><rect x="468.33" y="184.44" width="66.12" height="107.56" class="viz-fill-accent" data-label="Online · Last year" data-value="20" tabindex="0"/><text x="501.39" y="179.44" text-anchor="middle" class="viz-ink viz-value">20</text><rect x="540.2" y="76.89" width="66.12" height="215.11" class="viz-fill-accent" data-label="Online · This year" data-value="40" tabindex="0"/><text x="573.26" y="71.89" text-anchor="middle" class="viz-ink viz-value">40</text><g class="viz-annotation"><line x1="537.32" x2="537.32" y1="27" y2="58.89" class="viz-leader"/><text x="513.8" y="22" class="viz-ink viz-note">Up 100%</text></g></svg><p class="chart-source">Source: Synthetic fixture data</p><details class="chart-data"><summary>Show data</summary><div class="table-wrap"><table><thead><tr><th scope="col">Category</th><th scope="col" class="num">Last year</th><th scope="col" class="num">This year</th></tr></thead><tbody><tr><th scope="row">Retail</th><td class="num">40</td><td class="num">42</td></tr><tr><th scope="row">Wholesale</th><td class="num">30</td><td class="num">28</td></tr><tr><th scope="row">Online</th><td class="num">20</td><td class="num">40</td></tr></tbody></table></div></details></figure>
