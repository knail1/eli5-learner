{
  "name": "eli5-learner",
  "version": "0.1.0",
  "private": true,
  "description": "Turns decks, docs, PDFs, screenshots and URLs into interactive HTML explainers with an in-depth view and an ELI5 view.",
  "author": "Omer Ansari",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node --experimental-require-module node_modules/electron/install.js --no",
    "build:runtime": "vite build --config vite.doc-runtime.config.ts",
    "dev": "npm run build:runtime && ELI5_TEST_BUILD=1 electron-vite dev",
    "build": "npm run build:runtime && electron-vite build",
    "build:enterprise": "ELI5_EDITION=enterprise npm run build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-goldens": "ELI5_UPDATE_GOLDENS=1 vitest run",
    "fixtures:build": "ELI5_WRITE_FIXTURES=1 vitest run test/unit/fixtures/build.test.ts",
    "test:e2e": "ELI5_TEST_BUILD=1 npm run build && playwright test",
    "check:spec": "node scripts/check-spec-hooks.mjs",
    "package": "rimraf out build/doc-runtime && npm run build && electron-builder --mac dmg"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "exceljs": "^4.4.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "^2.1.0",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "fast-xml-parser": "^5.11.1",
    "jsdom": "^30.1.1",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "openai": "^7.23.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts": "^7.4.16",
    "ulid": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  }
}
