{
  "$id": "eli5-learner/sync/device.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": { "type": "number", "const": 1 },
    "deviceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "platform": { "type": "string", "enum": ["macos", "android"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "appVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "role": { "type": "string", "enum": ["primary", "mirror", "phone"] },
    "accepts": {
      "maxItems": 3,
      "type": "array",
      "items": { "type": "string", "enum": ["capture", "checkout", "ask"] }
    },
    "inbox": { "type": "string", "enum": ["on", "off", "paused-read-only"] }
  },
  "required": ["v", "deviceId", "platform", "name", "appVersion", "role", "accepts", "inbox"],
  "additionalProperties": false,
  "title": "DeviceRecord",
  "description": "device-<deviceId>.json (16 §4.3)"
}
