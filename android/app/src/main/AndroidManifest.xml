<?xml version="1.0" encoding="utf-8"?>
<!-- 16 §6.1, §7: the main activity imports through VIEW and SEND for text/html; the capture activity
     is the share target for links, text, images, PDF and Office files (16 §5.2); no backup of any data. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 16 §6.1. The local-mode reader makes no request: its WebView client answers every request
         itself (16 §6.3). Sync (later slices) uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sync (16 §6.1): "Large downloads on Wi-Fi only" and the WorkManager network constraint. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Learnings ready" (16 §6.1): asked only after the first capture, and only if the user opts in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".Eli5App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Eli5"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" from Files, email and browsers' downloads. -->
            <intent-filter android:label="@string/import_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <!-- Share sheet: an exported index.html shared from another app. -->
            <intent-filter android:label="@string/import_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <!-- The share target (16 §5.2, §6.2). Translucent, its own task, never in Recents. Intent
             filters are enforced (Android 16+), so an explicit intent cannot reach it with another
             action or type. text/html shares go to MainActivity as imports (16 §7). -->
        <activity
            android:name=".capture.CaptureActivity"
            android:exported="true"
            android:label="@string/capture_label"
            android:theme="@style/Theme.Eli5.Translucent"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:intentMatchingFlags="enforceIntentFilter"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="36">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 16 §6.5: "Share" hands a copy of a document to another app. Not exported; read access is
             granted per share through the intent; only cacheDir/share is served (@xml/share_paths). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
