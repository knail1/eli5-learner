{
  "name": "claude/structured",
  "interactions": [
    {
      "request": {
        "path": "/v1/messages",
        "match": { "output_config": { "format": { "type": "json_schema", "schema": { "type": "object" } } } }
      },
      "response": {
        "status": 200,
        "claudeMessage": {
          "model": "claude-opus-5-5",
          "content": [
            { "type": "thinking" },
            {
              "type": "text",
              "text": "{\"title\":\"Widget supply\",\"topicSlugHint\":\"widget-supply\",\"summary\":\"How Example Widgets Inc. plans supply.\"}"
            }
          ],
          "stop_reason": "end_turn",
          "usage": { "input_tokens": 300, "output_tokens": 40, "cache_read_input_tokens": 200 }
        }
      },
      "repeat": true
    }
  ]
}
