<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; Compose draws everything else (ui/theme/Theme.kt). -->
    <style name="Theme.Eli5" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The capture sheet's window: the sharing app stays visible behind the bottom sheet. -->
    <style name="Theme.Eli5.Translucent" parent="Theme.Eli5">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
