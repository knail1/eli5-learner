{
  "name": "openai/repair",
  "interactions": [
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": { "messages": [{ "role": "developer" }, { "role": "user" }] }
      },
      "response": {
        "status": 200,
        "openaiCompletion": {
          "model": "gpt-5",
          "content": "{\"title\":\"Widget supply\",\"topicSlugHint\":\"widget-supply\",\"summary\":null}",
          "finish_reason": "stop",
          "usage": { "prompt_tokens": 300, "completion_tokens": 20 }
        }
      }
    },
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": {
          "messages": [{ "role": "developer" }, { "role": "user" }, { "role": "assistant" }, { "role": "user" }]
        }
      },
      "response": {
        "status": 200,
        "openaiCompletion": {
          "model": "gpt-5",
          "content": "{\"title\":\"Widget supply\",\"topicSlugHint\":\"widget-supply\",\"summary\":\"Now valid.\"}",
          "finish_reason": "stop",
          "usage": { "prompt_tokens": 350, "completion_tokens": 25 }
        }
      }
    }
  ]
}
