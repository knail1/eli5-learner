{
  "name": "openai/image",
  "interactions": [
    {
      "request": {
        "path": "/v1/responses",
        "match": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "[Image: diagram.png]"
                },
                {
                  "type": "input_image",
                  "detail": "high"
                },
                {
                  "type": "input_text"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "openaiResponse": {
          "model": "gpt-5",
          "content": "The diagram shows two boxes joined by an arrow.",
          "status": "completed",
          "usage": {
            "input_tokens": 900,
            "output_tokens": 12
          }
        }
      },
      "repeat": true
    }
  ]
}
