{
  "name": "openai/errors",
  "interactions": [
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": { "messages": [{}, { "content": "contract:error:auth" }] }
      },
      "response": {
        "status": 401,
        "body": {
          "error": {
            "message": "Incorrect API key provided.",
            "type": "invalid_request_error",
            "param": null,
            "code": "invalid_api_key"
          }
        }
      },
      "repeat": true
    },
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": { "messages": [{}, { "content": "contract:error:bad_request" }] }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "message": "Invalid schema for response_format.",
            "type": "invalid_request_error",
            "param": "response_format",
            "code": null
          }
        }
      },
      "repeat": true
    },
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": { "messages": [{}, { "content": "contract:error:rate_limited" }] }
      },
      "response": {
        "status": 429,
        "headers": { "retry-after-ms": "1500" },
        "body": {
          "error": {
            "message": "Rate limit reached.",
            "type": "requests",
            "param": null,
            "code": "rate_limit_exceeded"
          }
        }
      },
      "repeat": true
    },
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": { "messages": [{}, { "content": "contract:error:overloaded" }] }
      },
      "response": {
        "status": 503,
        "body": {
          "error": {
            "message": "The engine is currently overloaded.",
            "type": "server_error",
            "param": null,
            "code": null
          }
        }
      },
      "repeat": true
    },
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": { "messages": [{}, { "content": "contract:error:server" }] }
      },
      "response": {
        "status": 502,
        "body": { "error": { "message": "Bad gateway.", "type": "server_error", "param": null, "code": null } }
      },
      "repeat": true
    },
    {
      "request": {
        "path": "/v1/chat/completions",
        "match": { "messages": [{}, { "content": "contract:error:context_overflow" }] }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "message": "This model's maximum context length is 400000 tokens.",
            "type": "invalid_request_error",
            "param": "messages",
            "code": "context_length_exceeded"
          }
        }
      },
      "repeat": true
    }
  ]
}
